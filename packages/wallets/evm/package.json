{
  "name": "@astrokit/wallet-evm",
  "version": "0.1.0",
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "scripts": {
    "clean": "rm -rf dist .turbo node_modules",
    "build": "tsup src/index.ts --dts --clean --format cjs,esm --out-dir dist",
    "test": "jest"
  },
  "keywords": [
    "astrokit",
    "wallet",
    "evm"
  ],
  "author": "This-Is-Prince",
  "license": "Apache-2.0",
  "dependencies": {
    "abitype": "^1.0.6",
    "astrokit": "workspace:*",
    "zod": "^3.24.1"
  },
  "peerDependencies": {
    "astrokit": "workspace:*"
  }
} 