{
  "name": "@astrokit/plugin-solana-ranger",
  "version": "0.1.0",
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "scripts": {
    "clean": "rm -rf dist .turbo node_modules",
    "build": "tsup src/index.ts --dts --clean --format cjs,esm --out-dir dist",
    "test": "jest"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/This-Is-Prince/astrokit.git"
  },
  "homepage": "https://github.com/This-Is-Prince/astrokit/tree/main/packages/plugins/solana-ranger",
  "keywords": [
    "solana",
    "ranger",
    "astrokit",
    "plugin",
    "defi",
    "perpetuals"
  ],
  "author": "This-Is-Prince",
  "license": "Apache-2.0",
  "dependencies": {
    "astrokit": "workspace:*",
    "base64-js": "^1.5.1",
    "zod": "^3.24.1"
  },
  "peerDependencies": {
    "@solana/web3.js": "^1.98.0",
    "astrokit": "workspace:*"
  }
}